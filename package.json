{
  "name": "bubbleverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "tauri": "tauri",
    "gen:blocks": "node scripts/gen-blocks.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "test": "vitest run",
    "check:hardcoded": "node scripts/check-hardcoded.ts",
    "check:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "check": "pnpm gen:blocks --check && pnpm lint && pnpm check:hardcoded && pnpm typecheck && pnpm test && pnpm check:rust",
    "test:perf": "node scripts/perf.ts",
    "test:e2e": "wdio run e2e/wdio.conf.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "webdriverio": "^9.32.0",
    "yaml": "^2.9.1"
  }
}
